{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd carboknot/extension && npm install --no-audit --no-fund --ignore-scripts",
  "buildCommand": "cd carboknot/extension && npm run build:web",
  "outputDirectory": "carboknot/extension/dist-web",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/api/climatiq", "destination": "/api/climatiq" },
    { "source": "/api/reason",   "destination": "/api/reason" },
    { "source": "/api/alternatives", "destination": "/api/alternatives" },
    { "source": "/api/health",   "destination": "/api/health" },
    { "source": "/health",       "destination": "/api/health" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "content-type, accept" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
