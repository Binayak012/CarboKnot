{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd carboknot/extension && npm install --no-audit --no-fund --legacy-peer-deps --ignore-scripts",
  "buildCommand": "cd carboknot/extension && npm run build:web",
  "outputDirectory": "carboknot/extension/dist-web",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
