# Carboknot proxy — environment template.
# Copy to .env for local dev. Set these in the Dedalus Machine's env for prod.
# NEVER commit .env.

# --- Dedalus LLM API (powers "Why is this lower carbon?" reasoning) ---
# Get keys at https://dedaluslabs.ai
DEDALUS_API_KEY=
DEDALUS_API_ENDPOINT=https://api.dedaluslabs.ai/v1/chat/completions
DEDALUS_MODEL=openai/gpt-5

# --- Climatiq (required for /api/climatiq and for the warmer) ---
# Get a key at https://climatiq.io. The default data_version ^21 pins
# the CEDA 2022 spend-based catalogue line currently used by the proxy.
CLIMATIQ_API_KEY=
CLIMATIQ_API_ENDPOINT=https://api.climatiq.io/data/v1/estimate
CLIMATIQ_DATA_VERSION=^21

# --- Dedalus Machines factor warmer ---
# Set WARMER_ENABLED=true on the VM; keep it false locally unless you want
# to burn Climatiq quota. Cache file must live on a persistent volume.
WARMER_ENABLED=false
WARMER_REFRESH_MIN=240
WARMER_CACHE_PATH=./data/cache.json
# Spacing between Climatiq calls during a warm pass. 500ms keeps us well
# under any plausible per-minute rate limit. ~40s for a full 77-call pass.
WARMER_CLIMATIQ_DELAY_MS=500
WARMER_INITIAL_DELAY_MS=5000
# Optional: if set, POST /swarm/refresh requires ?token=<this>.
# Leave blank for local dev. Set to a long random string in production.
WARMER_REFRESH_TOKEN=

# --- CORS ---
# Extension origin(s) permitted by CORS. Comma-separated.
# Get the extension ID from chrome://extensions after loading dist/.
# Example: chrome-extension://abcdefghijklmnop
ALLOWED_ORIGINS=

# --- Rate limit ---
# Hard cap per IP per minute for /api/reason + /api/climatiq.
# In-memory token bucket.
REASON_RATE_LIMIT_PER_MIN=10

PORT=8787
