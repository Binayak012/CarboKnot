# Carboknot proxy — environment template.
# Copy to .env for local dev. Set these in Render's env UI for production.
# NEVER commit .env.

# --- Dedalus LLM API (powers "Why is this lower carbon?" reasoning) ---
# Get keys at https://dedaluslabs.ai
# Use a proxy-specific key, not the same one your swarm enricher uses.
DEDALUS_API_KEY=
DEDALUS_API_ENDPOINT=https://api.dedaluslabs.ai/v1/chat/completions
DEDALUS_MODEL=openai/gpt-5

# --- Climatiq (optional: only if the proxy also fronts Climatiq for the
#     extension. If the Dedalus swarm watcher calls Climatiq directly and
#     publishes cache via /swarm/cache, leave this blank.) ---
CLIMATIQ_API_KEY=

# --- Dedalus swarm watcher endpoint ---
# The public URL the watcher Machine exposes its cache + status on.
# Teammate provides this after Step 7 of the swarm runbook.
# Example: https://<watcher>.dedalus.cloud
SWARM_WATCHER_ORIGIN=

# --- CORS ---
# Extension origin(s) permitted by CORS. Comma-separated.
# Get the extension ID from chrome://extensions after loading dist/.
# Example: chrome-extension://abcdefghijklmnop
ALLOWED_ORIGINS=

# --- Rate limit ---
# Hard cap per IP per minute for /api/reason. In-memory token bucket.
REASON_RATE_LIMIT_PER_MIN=10

PORT=8787
