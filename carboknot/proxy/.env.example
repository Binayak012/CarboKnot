# Carboknot Daedalus proxy — environment template.
# Copy to .env and fill in for local dev. Never commit .env.

# K2 Think V2 credentials (used by /api/reason)
K2_THINK_API_KEY=
K2_THINK_ENDPOINT=https://api.k2think.ai/v1/reason

# Fallback cloud LLM for /api/categorize (e.g. Groq, Together, OpenAI, Anthropic)
FALLBACK_LLM_KEY=
FALLBACK_LLM_ENDPOINT=
FALLBACK_LLM_MODEL=

# Extension origin(s) permitted by CORS. Comma-separated.
# Example: chrome-extension://<the-crxjs-generated-id>
ALLOWED_ORIGINS=

PORT=8787
